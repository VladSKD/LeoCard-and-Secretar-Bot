# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.

# AWS region. eu-central-1 (Frankfurt) is usually the lowest-latency for
# Ukrainian users; us-east-1 is the cheapest.
aws_region = "eu-central-1"

# Your SSH public key. The matching private key is what you'll use to
# connect. Generate a fresh one with:
#   ssh-keygen -t ed25519 -f ~/.ssh/telegram_bots_ec2 -C "telegram-bots-ec2"
public_key_path = "~/.ssh/telegram_bots_ec2.pub"

# CIDR allowed to reach SSH. Find your current IP with:
# curl ifconfig.me
# and append "/32".

# Example:
# allowed_ssh_cidr = "203.0.113.42/32"
# allowed_ssh_cidr = "CHANGE_ME/32"

# Optional overrides
# instance_type  = "t3.small"
# root_volume_gb = 30
