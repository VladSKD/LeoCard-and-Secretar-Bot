# ─────────────────────────────────────────────────────────────────────────────
# Monorepo env file. Copy to `.env` and fill in real values.
#
# All secrets are prefixed per bot so they don't collide. docker-compose.yml
# re-maps each prefixed var back to the plain name the bot's code expects
# (e.g. NEWBIE_BOT_TOKEN → BOT_TOKEN inside the newbie container). That keeps
# each bot's Python code untouched.
#
# Google OAuth credentials are NOT stored here anymore — they live as real
# JSON files under data/<bot>/credentials.json and data/<bot>/token.json,
# which are bind-mounted into the containers. See docs/DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# Global ─────────────────────────────────────────────────────────────────────
# Log level applied inside every container (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=INFO

# ── Leocard bot ──────────────────────────────────────────────────────────────
# Telegram bot token (from @BotFather)
LEOCARD_TELEGRAM_BOT_TOKEN=8970817410:AAGKo0YOnuDjXp91-jCypye2Of6c-tagqAE
# Google Drive root folder where per-party subfolders are created
LEOCARD_GOOGLE_ROOT_FOLDER_ID=1ttbKjow8BOMYVwNF_o-Qhmli_cJrY1hY
# Payment gateway URL shown to students
LEOCARD_PAYMENT_URL=https://easypay.ua/ua/catalog/bustickets/leocart
# Telegram chat ID that receives error notifications
LEOCARD_ADMIN_CHAT_ID=6132348011
# Template spreadsheet ID that each new "party" sheet is copied from
LEOCARD_TEMPLATE_SPREADSHEET_ID=1LJH8au8tpdfWY1AbfjKWdyb4pMkUA1YCF3N4MNdrpA0

# ── Newbie bot ───────────────────────────────────────────────────────────────
# Telegram bot token (from @BotFather)
NEWBIE_BOT_TOKEN=

# ── Profcom bot ──────────────────────────────────────────────────────────────
# Telegram bot token (from @BotFather)
PROFCOM_TELEGRAM_BOT_TOKEN=
# Google Gemini API key
PROFCOM_GOOGLE_API_KEY=
# Google Drive folder where generated petitions are uploaded
PROFCOM_GDRIVE_FOLDER_ID=
# Google Sheet ID used as a petition tracker
PROFCOM_GOOGLE_SHEET_ID=
# Optional: comma-separated list of chat IDs that receive petition notifications
PROFCOM_NOTIFICATION_CHATS=
# Port exposed by the aiohttp health-check endpoint (default 10000)
PROFCOM_PORT=10000

# ── Tickets bot ──────────────────────────────────────────────────────────────
# Deployed on a separate EC2. See bots/tickets/.env.example.
